{
  "name": "wingeul",
  "productName": "WinGeul",
  "version": "0.1.1",
  "description": "이기는 블로그 글 — 네이버 SERP 분석·불안 지도·브랜드 두뇌 기반 블로그 작성 데스크톱 앱",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "spike": "electron-vite build && electron . --spike="
  },
  "build": {
    "appId": "app.wingeul.desktop",
    "productName": "WinGeul",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!**/*.map"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WinGeul"
    },
    "dmg": {
      "title": "WinGeul ${version}"
    },
    "artifactName": "WinGeul-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "hubhub5",
        "repo": "wingeul",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": "WinGeul",
  "homepage": "https://hubhub5.github.io/wingeul/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hubhub5/wingeul.git"
  }
}
